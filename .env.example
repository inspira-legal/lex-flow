# =============================================================================
# LexFlow Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Most variables are optional and have sensible defaults.

# =============================================================================
# Web Search Opcodes (opcodes_web_search.py)
# =============================================================================

# Tavily API key for web search functionality
# Get your API key at: https://tavily.com/
TAVILY_API_KEY=

# =============================================================================
# Pydantic AI / Google Vertex AI (opcodes_pydantic_ai.py)
# =============================================================================

# Path to Google Cloud service account credentials JSON file
# Required for Vertex AI authentication if not using gcloud CLI
# Alternative: Run `gcloud auth application-default login`
GOOGLE_APPLICATION_CREDENTIALS=
